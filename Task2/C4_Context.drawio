        <mxCell id="2MdX_0r8jrADfNFMao8P-32" connectable="0" parent="2MdX_0r8jrADfNFMao8P-31" style="edgeLabel;html=1;align=left;verticalAlign=middle;resizable=0;points=[];" value="&lt;div&gt;Через веб или мобильное приложение&lt;/div&gt;&lt;div&gt;- Запись к врачу&lt;/div&gt;&lt;div&gt;- Просмотр медицинской карты&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- Просмотр результатов анализов&lt;/div&gt;&lt;div&gt;- Отмена/перенос записи&lt;/div&gt;" vertex="1">
